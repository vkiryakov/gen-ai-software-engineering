{
  "mcpServers": {
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/vkiryakov/workspace/set/gen-ai-software-engineering/homework-5"
      ]
    },
    "atlassian": {
      "type": "sse",
      "url": "https://mcp.atlassian.com/v1/sse"
    },
    "custom-lorem": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--python",
        "3.12",
        "--directory",
        "/Users/vkiryakov/workspace/set/gen-ai-software-engineering/homework-5/custom-mcp-server",
        "server.py"
      ]
    }
  }
}
